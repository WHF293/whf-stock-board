          "url": "https://*.eastmoney.com/*"
        },
        {
          "url": "https://eastmoney.com/*"
        },
        {
          "url": "https://*.gtimg.cn/*"
        },
        {
          "url": "https://gtimg.cn/*"
        },
        {
          "url": "https://*.sina.com.cn/*"
        },
        {
          "url": "https://*.sina.cn/*"
        },
        {
          "url": "https://*.sinajs.cn/*"
        },
        {
          "url": "https://*.10jqka.com/*"
        },
        {
          "url": "https://*.10jqka.com.cn/*"
        },
        {
          "url": "https://*.cls.cn/*"
        },
        {
          "url": "https://cls.cn/*"
        },
